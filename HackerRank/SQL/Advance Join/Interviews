--Print the contest_id, hacker_id, name, and the sums of total_submissions, total_accepted_submissions, total_views, and total_unique_views for each contest sorted by contest_id.

WITH CTE1 AS(
    SELECT challenge_id, SUM(total_views) AS tv, SUM(total_unique_views) AS uv
    FROM view_stats
    GROUP BY challenge_id
),
CTE2 AS(
    SELECT challenge_id, SUM(total_submissions) AS ts, SUM(total_accepted_submissions) AS ac
    FROM submission_stats
    GROUP BY challenge_id
),
CTE3 AS(
    SELECT college_id, SUM(tv) as tv, SUM(uv) as uv, SUM(ts) as ts, SUM(ac) as ac
    FROM challenges ch
    LEFT JOIN CTE1 USING(challenge_id)
    lEFT JOIN CTE2 USING(challenge_id)
    GROUP BY college_id
)

SELECT 
    c.contest_id, 
    c.hacker_id, 
    c.name,
    SUM(ts),
    SUM(ac),
    SUM(tv),
    SUM(uv)
FROM contests c
JOIN colleges cl USING(contest_id)
JOIN CTE3 using(college_id)
GROUP BY c.contest_id, c.hacker_id, c.name
HAVING SUM(ts) + SUM(ac) + SUM(tv) + SUM(uv) > 0
ORDER BY c.contest_id;
