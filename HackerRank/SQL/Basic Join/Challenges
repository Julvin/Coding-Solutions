#Print the hacker_id, name, and the total number of challenges created by each student. 
-- Sort your results by the total number of challenges in descending order. 
-- If more than one student created the same number of challenges, sort the result by hacker_id. 
-- If more than one student created the same number of challenges and the count is less than the maximum number of challenges created, then exclude those students from the result.

SELECT h.hacker_id, h.name, count(challenge_id) as cnt
FROM hackers h
JOIN challenges c USING(hacker_id)
GROUP BY h.hacker_id, h.name
HAVING 
    count(challenge_id) = (
        SELECT count(c1.challenge_id)
        FROM challenges c1
        GROUP BY c1.hacker_id
        ORDER BY count(c1.challenge_id) DESC
        LIMIT 1
    ) OR
    count(challenge_id) IN (
        SELECT cnt1
        FROM (
            SELECT h.hacker_id, h.name, count(challenge_id) as cnt1
            FROM hackers h
            JOIN challenges c USING(hacker_id)
            GROUP BY h.hacker_id, h.name
        ) as temp
        GROUP BY cnt1
        HAVING count(cnt1) = 1
    )
ORDER BY cnt DESC, h.hacker_id ASC
