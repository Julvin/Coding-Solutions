#The best way to choose is by determining the minimum number of gold galleons needed to buy each non-evil wand of high power and age.
#Print the id, age, coins_needed, and power of the wands that Ron's interested in, sorted in order of descending power. 
--If more than one wand has same power, sort the result in order of descending age.


WITH a AS(
SELECT age, MIN(coins_needed) as coins_needed, power
FROM wands w
JOIN 
    (SELECT * FROM wands_property WHERE is_evil = 0) AS wp USING(code)
GROUP BY age, power
)

SELECT w.id, a.age, a.coins_needed, a.power
FROM wands w
JOIN wands_property wp USING(code)
JOIN a USING(age, coins_needed, power)
ORDER BY a.power DESC, a.age DESC
