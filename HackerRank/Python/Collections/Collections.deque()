Perform append, pop, popleft and appendleft methods on an empty deque d.

Code:
from collections import deque

n = int(input())
d = deque()

for _ in range(n):
    a = list(input().split())
    
    if a[0] == 'append':
        d.append(int(a[1]))
    if a[0] == 'appendleft':
        d.appendleft(int(a[1]))
    if a[0] == 'pop':
        d.pop()
    if a[0] == 'popleft':
        d.popleft()

print(*d)
