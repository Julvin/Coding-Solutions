**ADVANCE SELECT**

1. New Companies

Solution 1
WITH lm AS (
    SELECT company_code, COUNT(DISTINCT lead_manager_code) AS lmc
    FROM lead_manager
    GROUP BY company_code
), 
sm AS(
    SELECT company_code, COUNT(DISTINCT senior_manager_code) AS smc, lmc
    FROM senior_manager
    JOIN lm USING(company_code)
    GROUP BY company_code
),
m AS(
    SELECT company_code, COUNT(DISTINCT manager_code) AS mc, lmc, smc
    FROM manager
    JOIN sm USING(company_code)
    GROUP BY company_code
),
e AS(
    SELECT company_code, COUNT(DISTINCT employee_code) AS ec, mc, lmc, smc
    FROM employee
    JOIN m USING(company_code)
    GROUP BY company_code
)

SELECT c.company_code, founder, e.lmc, e.smc, e.mc, e.ec
FROM company c
JOIN e USING(company_code)
ORDER BY c.company_code;

Solution 2
SELECT 
    c.company_code, 
    c.founder,
    COUNT(DISTINCT lm.lead_manager_code),
    COUNT(DISTINCT sm.senior_manager_code),
    COUNT(DISTINCT m.manager_code),
    COUNT(DISTINCT e.employee_code)
FROM company c
JOIN lead_manager lm USING(company_code)
JOIN senior_manager sm USING(company_code)
JOIN manager m USING(company_code)
JOIN employee e USING(company_code)
GROUP BY c.company_code, c.founder
ORDER BY c.company_code;

2. Binary Tree
SELECT 
    N,
    CASE 
        WHEN P IS NULL THEN "Root"
        WHEN N IN (SELECT DISTINCT P FROM BST WHERE P IS NOT NULL) THEN "Inner"
        ELSE "Leaf"
    END AS b
FROM BST
ORDER BY N ASC


**ADVANCE JOIN**

1. SQL Project Planning
WITH cte1 AS (
    SELECT start_date
    FROM projects
    WHERE start_date NOT IN (SELECT End_Date FROM projects)
),
cte2 AS (
    SELECT start_date, RANK() OVER(ORDER BY start_date) AS rnk
    FROM cte1
),
cte3 AS (
    SELECT end_date
    FROM projects
    WHERE end_date NOT IN (SELECT start_date FROM projects)
),
cte4 AS (
    SELECT end_date, RANK() OVER(ORDER BY end_date) AS rnk
    FROM cte3
)

SELECT cte2.start_date, cte4.end_date
FROM cte2
JOIN cte4 USING(rnk)
ORDER BY DATEDIFF(cte2.start_date,cte4.end_date) DESC;

2. Symmetric Pairs
SELECT f1.x, f1.y
FROM functions f1
JOIN functions f2
    ON f1.x = f2.y
   AND f1.y = f2.x
GROUP BY f1.x, f1.y
HAVING COUNT(f1.x) > 1 OR f1.x < f1.y
ORDER BY f1.x ASC;

3. Interviews
WITH CTE1 AS(
    SELECT challenge_id, SUM(total_views) AS tv, SUM(total_unique_views) AS uv
    FROM view_stats
    GROUP BY challenge_id
),
CTE2 AS(
    SELECT challenge_id, SUM(total_submissions) AS ts, SUM(total_accepted_submissions) AS ac
    FROM submission_stats
    GROUP BY challenge_id
),
CTE3 AS(
    SELECT college_id, SUM(tv) as tv, SUM(uv) as uv, SUM(ts) as ts, SUM(ac) as ac
    FROM challenges ch
    LEFT JOIN CTE1 USING(challenge_id)
    lEFT JOIN CTE2 USING(challenge_id)
    GROUP BY college_id
)

SELECT 
    c.contest_id, 
    c.hacker_id, 
    c.name,
    SUM(ts),
    SUM(ac),
    SUM(tv),
    SUM(uv)
FROM contests c
JOIN colleges cl USING(contest_id)
JOIN CTE3 using(college_id)
GROUP BY c.contest_id, c.hacker_id, c.name
HAVING SUM(ts) + SUM(ac) + SUM(tv) + SUM(uv) > 0
ORDER BY c.contest_id;

**Basic Join**

1. The Report
SELECT IF(g.grade < 8, NULL, Name), grade, marks
FROM students s
lEFT JOIN grades g ON s.marks BETWEEN min_mark AND max_mark
ORDER BY grade DESC, name ASC, marks ASC 

2. Top Company
WITH CTE AS(
    SELECT s.hacker_id, count(*) as cnt
    FROM submissions s
    LEFT JOIN challenges c USING(challenge_id)
    LEFT JOIN difficulty d USING(difficulty_level)
    WHERE s.score = d.score
    GROUP BY s.hacker_id
)

SELECT h.hacker_id, h.name
FROM hackers h
JOIN CTE USING(hacker_id)
WHERE cnt > 1
ORDER BY cnt DESC, hacker_id ASC

3. Challenges
SELECT h.hacker_id, h.name, count(challenge_id) as cnt
FROM hackers h
JOIN challenges c USING(hacker_id)
GROUP BY h.hacker_id, h.name
HAVING 
    count(challenge_id) = (
        SELECT count(c1.challenge_id)
        FROM challenges c1
        GROUP BY c1.hacker_id
        ORDER BY count(c1.challenge_id) DESC
        LIMIT 1
    ) OR
    count(challenge_id) IN (
        SELECT cnt1
        FROM (
            SELECT h.hacker_id, h.name, count(challenge_id) as cnt1
            FROM hackers h
            JOIN challenges c USING(hacker_id)
            GROUP BY h.hacker_id, h.name
        ) as temp
        GROUP BY cnt1
        HAVING count(cnt1) = 1
    )
ORDER BY cnt DESC, h.hacker_id ASC

4. Ollivander's Inventory
WITH a AS(
SELECT age, MIN(coins_needed) as coins_needed, power
FROM wands w
JOIN 
    (SELECT * FROM wands_property WHERE is_evil = 0) AS wp USING(code)
GROUP BY age, power
)

SELECT w.id, a.age, a.coins_needed, a.power
FROM wands w
JOIN wands_property wp USING(code)
JOIN a USING(age, coins_needed, power)
ORDER BY a.power DESC, a.age DESC

5. Contest Leaderboard
WITH CTE AS(
    SELECT hacker_id, challenge_id, max(score) as ms
    FROM submissions
    GROUP BY hacker_id, challenge_id 
)

SELECT h.hacker_id, h.name, SUM(ms)
FROM hackers h
JOIN CTE c USING(hacker_id)
GROUP BY h.hacker_id, h.name
HAVING SUM(ms) > 0
ORDER BY SUM(ms) DESC, h.hacker_id ASC

**ALternative Queries**
1. Print Prime Numbers
WITH RECURSIVE numbers AS(
    SELECT 2 AS L
    UNION ALL
    
    SELECT L + 1
    FROM numbers
    WHERE L < 1000
)

SELECT GROUP_CONCAT(L SEPARATOR "&") 
FROM numbers n 
WHERE NOT EXISTS(
    SELECT *
    FROM numbers n2
    WHERE n2.L > 1 AND n2.L < n.l AND n.L % n2.L = 0
)


**Aggregation**

1. Weather Observation Station 20

Solution 1
WITH CTE AS (
    SELECT 
            LAT_N, 
            ROW_NUMBER() OVER (ORDER BY LAT_N) AS rn,
            COUNT(*) OVER () AS total
    FROM station
)

SELECT ROUND(AVG(LAT_N), 4)
FROM CTE
WHERE rn IN (
    FLOOR((total + 1) / 2), 
    FLOOR((total + 2) / 2)
);

