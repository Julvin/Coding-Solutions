1. Day of the Programmer
def dayOfProgrammer(year):
    if year == 1918:
        return "26.09.1918"
    elif year < 1918 and year%4 == 0:
        return f'12.09.{year}'
    elif year < 1918:
        return f'13.09.{year}'
    else:
        if year%400 == 0 or (year%100 != 0 and year%4 == 0):
            return f'12.09.{year}'
        else:
            return f'13.09.{year}'

